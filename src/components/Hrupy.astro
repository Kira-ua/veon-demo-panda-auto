---
// #hrupy: the one ink insert. Index of part groups (future pages) + a line about car goods (products_services[1], [3], business_lines[1]).
import FutureLink from "./FutureLink.astro";
import { groups } from "../data/site";
---
<section id="hrupy" class="hrupy on-dark">
  <div class="hrupy__in container">
    <div class="hrupy__head">
      <h2 class="h2">Групи запчастин</h2>
      <p class="hrupy__text">Основні з 18 груп каталогу. Серед автотоварів — автоелектроніка, зокрема зарядні станції EcoFlow і Bluetti, світло, мастила й рідини, інструменти, догляд. Є власна марка рідин PANDA: антифриз G12 і омивач.</p>
    </div>
    <ul class="hrupy__list">
      {groups.map((g) => <li><FutureLink class="hrupy__item">{g}</FutureLink></li>)}
    </ul>
  </div>
</section>

<style is:global>
  .hrupy { background: var(--color-ink); color: var(--color-snow); padding-block: var(--section-y); }
  .hrupy__in { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-7); }
  .hrupy__text { margin-top: var(--space-5); color: var(--color-mint); font-size: var(--text-17); max-width: 48ch; }
  .hrupy__list { display: grid; grid-template-columns: minmax(0, 1fr); }
  .hrupy__list li { border-top: var(--hairline) solid var(--color-muted); }
  .hrupy__item.future-link {
    display: flex; min-height: var(--control); padding-block: var(--space-2);
    font-family: var(--font-display); font-stretch: var(--wdth-display); font-weight: 700; font-size: var(--text-28); line-height: 1.1;
    color: var(--color-snow); text-decoration-color: var(--color-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .hrupy__item.future-link:hover { color: var(--color-lime); }
  @media (min-width: 768px) {
    .hrupy__list { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--gutter); }
    .hrupy__item.future-link { font-size: var(--text-36); }
  }
  @media (min-width: 1024px) {
    .hrupy__in { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    .hrupy__head { grid-column: 1 / 5; }
    .hrupy__list { grid-column: 5 / 13; }
  }
</style>
