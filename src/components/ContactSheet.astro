---
// «Написати менеджеру»: native modal <dialog> (focus stays inside, Esc closes), click outside and a close button.
// Phone: bottom sheet. Desktop: centred popover. No form: every row is a real channel.
import Icon from "./Icon.astro";
import { contacts, waLink } from "../data/site";
---
<dialog class="sheet" id="napysaty" aria-labelledby="sheet-title" data-sheet data-rec="R-102,R-101">
  <div class="sheet__in">
    <div class="sheet__head">
      <h2 class="sheet__title" id="sheet-title">Написати менеджеру</h2>
      <button class="sheet__close" type="button" aria-label="Закрити" data-sheet-close><Icon name="close" /></button>
    </div>
    <p class="sheet__hint">Надішліть VIN, фото техпаспорта, артикул або назву деталі.</p>
    <ul class="sheet__list">
      <li><a class="btn btn--secondary" href={waLink()} target="_blank" rel="noopener"><Icon name="chat" />WhatsApp</a></li>
      <li><a class="btn btn--secondary" href={contacts.telegram} target="_blank" rel="noopener"><Icon name="send" />Telegram</a></li>
      <li><a class="btn btn--secondary" href={contacts.viber.href} data-rec="R-109"><Icon name="viber" />Viber {contacts.viber.text}</a></li>
      {contacts.phones.map((p) => <li><a class="btn btn--secondary" href={p.href}><Icon name="phone" />Подзвонити {p.text}</a></li>)}
    </ul>
  </div>
</dialog>

<style is:global>
  .sheet {
    width: 100%; max-width: 100%; margin: auto 0 0; padding: 0; border: 0;
    border-radius: var(--radius) var(--radius) 0 0; background: var(--color-snow); color: var(--color-ink);
  }
  .sheet::backdrop { background: var(--color-scrim); }
  .sheet__in { padding: var(--space-5) var(--page-pad) var(--space-6); }
  .sheet__head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); }
  .sheet__title { font-family: var(--font-display); font-stretch: var(--wdth-display); font-weight: 800; font-size: var(--text-32); line-height: 1; }
  .sheet__close {
    display: inline-grid; place-items: center; width: var(--target); height: var(--target); flex: none;
    border: var(--hairline) solid var(--color-line); border-radius: var(--radius); background: var(--color-snow); cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .sheet__close:hover { background: var(--color-snow-hover); }
  .sheet__hint { margin-top: var(--space-3); color: var(--color-muted); font-size: var(--text-16); }
  .sheet__list { display: grid; gap: var(--space-3); margin-top: var(--space-5); }
  .sheet__list .btn { width: 100%; min-height: var(--control-lg); justify-content: flex-start; }
  /* Motion #3: bottom sheet slides up on a phone, popover fades and scales on desktop */
  @media (prefers-reduced-motion: no-preference) {
    .sheet[open] { animation: sheet-up var(--dur-sheet) var(--ease-out); }
  }
  @keyframes sheet-up { from { transform: translateY(100%); } to { transform: none; } }
  @keyframes sheet-pop { from { opacity: 0; transform: scale(.98); } to { opacity: 1; transform: none; } }
  @media (min-width: 768px) {
    .sheet { width: min(100% - 2 * var(--page-pad), 480px); margin: auto; border-radius: var(--radius); }
    .sheet__in { padding: var(--space-6); }
  }
  @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
    .sheet[open] { animation: sheet-pop var(--dur-pop) var(--ease-out); }
  }
</style>
